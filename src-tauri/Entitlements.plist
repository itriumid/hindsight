<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Tauri signs the app with the hardened runtime, under which macOS refuses the microphone
       (silently, with no prompt) unless the signature declares audio input. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
